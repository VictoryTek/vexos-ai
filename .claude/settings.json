{
  "effortLevel": "medium",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current:*)",
      "Bash(stat:*)",
      "Bash(nix build:*)",
      "Bash(nix eval:*)",
      "Bash(shellcheck:*)",
      "Bash(scripts/preflight.sh:*)",
      "Bash(nix develop:*)",
      "Bash(bash -n:*)",
      "WebSearch",
      "mcp__context7",
      "mcp__nixos"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(rm -rf:*)",
      "Bash(nixos-rebuild switch:*)",
      "Bash(nixos-rebuild boot:*)",
      "Bash(nixos-rebuild test:*)",
      "Bash(sudo nixos-rebuild switch:*)",
      "Bash(sudo nixos-rebuild boot:*)",
      "Bash(sudo nixos-rebuild test:*)",
      "Bash(pkexec nixos-rebuild switch:*)",
      "Bash(pkexec nixos-rebuild boot:*)",
      "Bash(pkexec nixos-rebuild test:*)",
      "Bash(just rebuild:*)",
      "Bash(just switch:*)",
      "Bash(just update:*)",
      "Bash(just update-all:*)",
      "Bash(sudo just rebuild:*)",
      "Bash(sudo just switch:*)",
      "Bash(sudo just update:*)",
      "Bash(sudo just update-all:*)",
      "Bash(pkexec just rebuild:*)",
      "Bash(pkexec just switch:*)",
      "Bash(pkexec just update:*)",
      "Bash(pkexec just update-all:*)",
      "Bash(nix flake check:*)",
      "Bash(sudo nix flake check:*)",
      "Bash(pkexec nix flake check:*)",
      "Bash(nix-collect-garbage:*)",
      "Bash(nix store gc:*)",
      "Bash(sudo nix-collect-garbage:*)",
      "Bash(sudo nix store gc:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
