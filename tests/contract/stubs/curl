#!/usr/bin/env bash
# Tripwire. vexos-ai makes no network request and sends no token (docs/contract.md),
# so nothing may call curl. Records argv and stdin, then fails; the tests assert
# that $STUB_LOG/curl.count never appears.
log=${STUB_LOG:?}
printf '%s\n' "$@" >>"$log/curl.argv"
[[ -t 0 ]] || cat >>"$log/curl.stdin"
echo call >>"$log/curl.count"
exit 99
