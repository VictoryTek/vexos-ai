<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.vexos-assistant"
          path="/org/gnome/shell/extensions/vexos-assistant/">
    <!-- Unbound by GNOME Shell, Mutter and the window manager by default;
         Super+Shift+A is taken by vexos-nix's terminal launcher. -->
    <key name="toggle-assistant" type="as">
      <default><![CDATA[['<Super>F12']]]></default>
      <summary>Show or hide the VexOS Assistant</summary>
    </key>
    <!-- Shared with the app, which writes it from its header button. Only these
         two strings are ever stored; both sides treat anything else as docked. -->
    <key name="window-mode" type="s">
      <choices>
        <choice value="docked"/>
        <choice value="floating"/>
      </choices>
      <default>'docked'</default>
      <summary>Assistant window: docked under the top bar, or floating</summary>
    </key>
  </schema>
</schemalist>
